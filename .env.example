# Local SQLite. For hosted Turso, use a libsql:// URL and its auth token.
TURSO_DATABASE_URL=file:./goodfind.local.db
TURSO_AUTH_TOKEN=

# Choose a local password and a random secret of at least 32 characters.
BOHO_PASSWORD=
BOHO_SECRET=

# Optional integrations
LOOPS_API_KEY=
ANTHROPIC_API_KEY=
EXASEARCH_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
